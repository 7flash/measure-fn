{
  "name": "measure-fn",
  "version": "5.3.1",
  "description": "Zero-dependency function performance measurement with hierarchical logging",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "context.ts",
    "index.ts",
    "browser.ts",
    "runtime.ts",
    "serialization.ts",
    "logger.ts",
    "public.ts",
    "types.ts",
    "format.ts",
    "config.ts",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "private": false,
  "keywords": [
    "measure",
    "performance",
    "timing",
    "logging",
    "tracing",
    "hierarchical"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/7flash/measure-fn"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "1.2.17",
    "typescript": "5.8.3",
    "esbuild": "0.25.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && npm run test:node && npm run test:browser",
    "example": "bun run examples/basic.ts",
    "typecheck": "tsc --noEmit",
    "example:logger": "bun run examples/custom-logger.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run test:package",
    "test:node": "node --test tests/contracts.node.mjs",
    "test:browser": "node --test tests/browser.node.mjs",
    "test:browser:runtime": "npm run build && node scripts/test-browser-runtime.mjs",
    "test:bun": "bun test",
    "bench": "bun run bench.ts",
    "test:package": "node scripts/test-package.mjs"
  },
  "browser": "./dist/browser.js",
  "engines": {
    "node": ">=18.0.0"
  }
}
